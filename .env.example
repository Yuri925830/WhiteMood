# Server-only. Never use a VITE_ prefix for private credentials.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional local FastAPI sidecar. Leave unset to keep the existing voice-only path.
# Example: http://127.0.0.1:8790
ANALYSIS_API_URL=
# Use the same random value as WHITEMOOD_ANALYSIS_TOKEN in the sidecar environment.
ANALYSIS_API_TOKEN=
# Local development binds to loopback. Use an authenticated HTTPS gateway for remote access.
PORT=8787
